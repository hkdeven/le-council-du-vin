# Supabase — fill these in from your project's API settings.
# Until they're set, the app runs in demo mode with seeded data.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SITE_URL=https://lecouncilduvin.netlify.app

# Login wall. Leave false (or unset) to keep the app open and navigable even with
# Supabase connected. Set to true once auth is configured to require login.
NEXT_PUBLIC_ENFORCE_LOGIN=false

# Petition-notification email (Resend). When both are set, the Keiser is emailed
# on every new petition (/api/notify-petition). Leave unset to disable.
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=keiser@example.com
# Optional: a verified Resend sender. Until you verify a domain, Resend's test
# sender (onboarding@resend.dev) only delivers to your own Resend account email.
NOTIFY_FROM=Le Council du Vin <onboarding@resend.dev>
